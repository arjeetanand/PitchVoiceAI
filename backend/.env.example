# Optional provider-backed generation and speech. Extractive Q&A works without keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
TTS_PROVIDER=browser
# Recommended local studio voice (install backend/requirements-kokoro.txt first):
# TTS_PROVIDER=kokoro
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.98
KOKORO_DEVICE=auto
PIPER_TTS_URL=
PIPER_TTS_VOICE=
PITCH_DOCUMENT_PATH=./data/pitch.txt
MAX_DOCUMENT_CHARS=50000
MAX_AUDIO_BYTES=10485760
FRONTEND_ORIGINS=http://127.0.0.1:8501,http://localhost:8501,http://localhost:3000,http://localhost:5173
SARVAM_API_KEY=
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_SPEAKER=shubh
SARVAM_TTS_MODEL=bulbul:v3
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference
HUGGINGFACE_ASR_MODEL=openai/whisper-large-v3-turbo
HUGGINGFACE_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
ANSWER_GENERATION_PROVIDER=extractive
HUGGINGFACE_TTS_MODEL=suno/bark-small
HUGGINGFACE_TTS_VOICE=v2/en_speaker_6
# Keep this off unless you have downloaded the local model intentionally.
HUGGINGFACE_TTS_MODE=off
HUGGINGFACE_TTS_MEDIA_TYPE=audio/wav
