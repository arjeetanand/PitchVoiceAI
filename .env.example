# ============================================================================
# Pitchroom AI — one configuration file
# ============================================================================
# Copy this file to the repository root as `.env`:
#
#     cp .env.example .env
#
# Keep real API keys only in `.env` or your deployment secret settings. The
# running app reads this root file; there is no backend-specific env file.

# ----------------------------------------------------------------------------
# 1) Demo runtime and source document
# ----------------------------------------------------------------------------
# The bundled brief is the safe default for a presentation.
PITCH_DOCUMENT_PATH=./data/pitch.txt
MAX_DOCUMENT_CHARS=50000
MAX_AUDIO_BYTES=10485760

# Comma-separated browser origins allowed to call the API. The shipped live
# room is same-origin; keep these values for local development and API docs.
FRONTEND_ORIGINS=http://127.0.0.1:8501,http://localhost:8501,http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------------------------
# 2) Answers and speech-to-text
# ----------------------------------------------------------------------------
# `extractive` is the fast, grounded, no-key answer path used by default.
# Set `huggingface` only when you intentionally want hosted answer generation.
ANSWER_GENERATION_PROVIDER=extractive

# Live microphone questions use Hugging Face Whisper transcription.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference
HUGGINGFACE_ASR_MODEL=openai/whisper-large-v3-turbo

# Optional hosted answer model (only used when ANSWER_GENERATION_PROVIDER=
# huggingface).
HUGGINGFACE_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct

# ----------------------------------------------------------------------------
# 3) Text-to-speech provider
# ----------------------------------------------------------------------------
# Choose one: browser | kokoro | piper | sarvam | huggingface | openai | auto
# `browser` is the zero-install fallback. Use `kokoro` for the recommended
# smooth local studio voice after installing backend/requirements-kokoro.txt.
TTS_PROVIDER=browser

# Recommended local Kokoro studio voice. These values are ignored unless
# TTS_PROVIDER=kokoro.
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.98
KOKORO_DEVICE=auto

# Optional local Piper HTTP service. Used when TTS_PROVIDER=piper or as part of
# the `auto` fallback chain.
PIPER_TTS_URL=
PIPER_TTS_VOICE=

# ----------------------------------------------------------------------------
# 4) Optional hosted speech providers
# ----------------------------------------------------------------------------
# Sarvam Bulbul (used only when selected or when TTS_PROVIDER=auto).
SARVAM_API_KEY=
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_SPEAKER=shubh
SARVAM_TTS_MODEL=bulbul:v3

# OpenAI speech fallback (used only when selected or when TTS_PROVIDER=auto).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Hugging Face text-to-speech. Keep mode `off` unless you deliberately choose
# the local model or the hosted API path.
HUGGINGFACE_TTS_MODE=off
HUGGINGFACE_TTS_MODEL=suno/bark-small
HUGGINGFACE_TTS_VOICE=v2/en_speaker_6
HUGGINGFACE_TTS_MEDIA_TYPE=audio/wav

# ----------------------------------------------------------------------------
# 5) Legacy Streamlit wrapper (optional)
# ----------------------------------------------------------------------------
# The presentation app started by ./run-dev.sh does not use these values.
# They are retained only for the older `streamlit run frontend/app.py` path.
BACKEND_URL=http://localhost:8000
ALLOW_CUSTOM_BACKEND_URL=false
